# Public URL of the FastAPI backend, no trailing slash.
# Local: http://localhost:8000
# Vercel: set VITE_API_BASE_URL in Project Settings -> Environment Variables
#         to the Railway domain, e.g. https://srhu-capture-api.up.railway.app,
#         then redeploy (Vite bakes it in at build time).
# Only the dev server rewrites localhost/127.0.0.1 to the page's host (for
# testing from another device on the LAN). A production build uses this value
# as-is and logs an error if it still points at localhost. If it is missing,
# the site shows a "not configured" screen instead of loading.
VITE_API_BASE_URL=http://localhost:8000
