# Public URL of the FastAPI backend, no trailing slash.
# Local: http://localhost:8000
# Vercel: set VITE_API_BASE_URL in Project Settings -> Environment Variables
#         to the Railway domain, e.g. https://srhu-capture-api.up.railway.app,
#         then redeploy (Vite bakes it in at build time).
VITE_API_BASE_URL=http://localhost:8000
