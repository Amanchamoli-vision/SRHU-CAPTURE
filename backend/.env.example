# Supabase (existing application configuration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail / Google Workspace SMTP (App Password required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Public frontend origin used in every server-generated email redirect.
# Add this exact origin to Supabase Auth > URL Configuration > Redirect URLs.
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed to call the FastAPI API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
