# Select one backend-only email provider: smtp (default) or resend.
EMAIL_PROVIDER=smtp

# Gmail / Google Workspace SMTP (App Password required).
# Use exactly one supported transport: 465 for implicit SSL/TLS or 587 for STARTTLS.
# Gmail supports both; this example uses implicit SSL/TLS on 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
=======
# Public anon key, used for the signup request so that Supabase Auth sends the
# confirmation email itself. Same value as the frontend's VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Email delivery is handled entirely by Supabase Auth, so this service needs no
# SMTP credentials and makes no outbound SMTP connection. Configure delivery in the
# Supabase dashboard instead:
#   Auth > SMTP Settings     - custom sender (the built-in one is rate limited)
#   Auth > Email Templates   - "Confirm signup" wording
#   Auth > URL Configuration - add FRONTEND_URL and FRONTEND_URL/login as Redirect URLs
>>>>>>> Stashed changes

# Resend HTTPS email API. Recommended on Railway plans where SMTP is blocked.
# Set EMAIL_PROVIDER=resend and use an address at a domain verified in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=notifications@your-verified-domain.example

# Public frontend origin used in every server-generated email redirect.
# Must be a bare origin: scheme and host only, no path or trailing slash.
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed to call the FastAPI API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
