# ---------------------------------------------------------------
# MongoDB (the only database used by the application)
# ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=campus_capture

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# Long random string used to sign login tokens. Keep it secret.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Set to false to let new accounts sign in without confirming their email
# (useful before SMTP is configured).
REQUIRE_EMAIL_VERIFICATION=true

# ---------------------------------------------------------------
# SMTP (verification, password reset and event status emails)
# ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Campus Capture SRHU
# STARTTLS on 587 (default). For implicit TLS on 465 set SMTP_USE_SSL=true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins
# CORS_ORIGINS=http://192.168.1.10:5173

# Maximum size of a single uploaded file (MB)
MAX_UPLOAD_SIZE_MB=25
