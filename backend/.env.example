# ---------------------------------------------------------------
# MongoDB (the only database used by the application)
# ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=campus_capture

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# Long random string used to sign login tokens. Keep it secret.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Set to false to let new accounts sign in without confirming their email
# (useful before SMTP is configured).
REQUIRE_EMAIL_VERIFICATION=true

# ---------------------------------------------------------------
# SMTP (verification, password reset and event status emails)
# ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Campus Capture SRHU
# STARTTLS on 587 (default). For implicit TLS on 465 set SMTP_USE_SSL=true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---------------------------------------------------------------
# Email transport
# ---------------------------------------------------------------
# smtp (default) | brevo | resend
# Railway's Free/Trial/Hobby plans block outbound SMTP: use brevo or resend
# there. SMTP_FROM_EMAIL / SMTP_FROM_NAME are still the From address, and must
# be a sender verified with the chosen provider.
EMAIL_PROVIDER=smtp
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...

# ---------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins
# CORS_ORIGINS=http://192.168.1.10:5173
# Origins matched by pattern. Defaults to localhost + private LAN addresses.
# In production, admit only your Vercel deployments (previews included):
# CORS_ORIGIN_REGEX=^https://srhu-capture(-[a-z0-9-]+)?\.vercel\.app$

# Maximum size of a single uploaded file (MB)
MAX_UPLOAD_SIZE_MB=25

# ---------------------------------------------------------------
# Cloudflare R2 (optional; uploads fall back to MongoDB GridFS)
# ---------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Public bucket URL; leave empty for a private bucket with signed URLs
# R2_PUBLIC_URL=
