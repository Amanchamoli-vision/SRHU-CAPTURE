# Secrets — the live .env and every copy of it (.env.bak-*, .env.local, ...),
# which carry the same JWT key and SMTP password. The template is the exception.
.env
.env.*
!.env.example

# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
